---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	intake(intake)
	billing(billing)
	tech(tech)
	draft(draft)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> intake;
	billing --> tech;
	draft --> finish;
	intake --> billing;
	tech --> draft;
	finish --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

