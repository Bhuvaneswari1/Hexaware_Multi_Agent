# Demo mode makes NO LLM calls. Change to live for real model/tool agents.
APP_MODE=demo
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# local_hash = reproducible lexical vectors; openai = paid semantic embeddings
EMBEDDING_BACKEND=local_hash
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supportdesk-training
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional: set your current provider rates to calculate local estimated cost.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
# Classroom API keys. Replace these before sharing a deployment.
DESK_API_KEY=classroom-customer-key
REVIEWER_API_KEY=classroom-reviewer-key
